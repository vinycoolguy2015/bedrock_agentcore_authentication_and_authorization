#!/bin/bash
# =============================================================================
# Workshop Configuration
# =============================================================================
# Customize these values before running deploy.sh

export AWS_PROFILE="default"
export AWS_REGION="us-east-1"
export PROJECT_NAME="agentcore-mcp-ws"

# Auto-detect AWS Account ID (populated at runtime)
export ACCOUNT_ID=""

# ---------- Cognito (Trust Domain 1) ----------
export COGNITO_D1_POOL_NAME="${PROJECT_NAME}-domain1-pool"
export COGNITO_D1_DOMAIN="${COGNITO_D1_DOMAIN:-${PROJECT_NAME}-d1-$(date +%s)}"
export COGNITO_D1_APP_CLIENT_NAME="${PROJECT_NAME}-d1-app"

# ---------- Cognito (Trust Domain 2) ----------
export COGNITO_D2_POOL_NAME="${PROJECT_NAME}-domain2-pool"
export COGNITO_D2_DOMAIN="${COGNITO_D2_DOMAIN:-${PROJECT_NAME}-d2-$(date +%s)}"
export COGNITO_D2_APP_CLIENT_NAME="${PROJECT_NAME}-d2-app"

# ---------- IAM Roles ----------
export LAMBDA_ROLE_NAME="${PROJECT_NAME}-lambda-role"
export AGENT_ROLE_NAME="${PROJECT_NAME}-agent-role"
export EDGE_LAMBDA_ROLE_NAME="${PROJECT_NAME}-edge-lambda-role"
export GATEWAY_ROLE_NAME="${PROJECT_NAME}-gateway-role"
export DYNAMODB_ROLE_NAME="${PROJECT_NAME}-dynamodb-role"

# ---------- Lambda Functions ----------
export TOS_LAMBDA_NAME="${PROJECT_NAME}-terms-of-service"
export PRODUCTS_LAMBDA_NAME="${PROJECT_NAME}-products"
export SALES_LAMBDA_NAME="${PROJECT_NAME}-sales"
export INVENTORY_LAMBDA_NAME="${PROJECT_NAME}-inventory"
export AUTHORIZER_LAMBDA_NAME="${PROJECT_NAME}-jwt-authorizer"
export EDGE_LAMBDA_NAME="${PROJECT_NAME}-edge-auth"

# ---------- DynamoDB ----------
export REVIEWS_TABLE_NAME="${PROJECT_NAME}-customer-reviews"

# ---------- API Gateway ----------
export PRODUCTS_API_NAME="${PROJECT_NAME}-products-api"
export SALES_API_NAME="${PROJECT_NAME}-sales-api"
export INVENTORY_API_NAME="${PROJECT_NAME}-inventory-api"

# ---------- S3 + CloudFront ----------
export UI_BUCKET_NAME=""  # Set after ACCOUNT_ID is resolved

# ---------- AgentCore ----------
export AGENT_RUNTIME_NAME="agentcore_mcp_ws_retail_agent"
export IDENTITY_D1_NAME="agentcore_mcp_ws_identity_d1"
export IDENTITY_D2_NAME="agentcore_mcp_ws_identity_d2"

# ---------- MCP Gateways (AgentCore Gateway) ----------
export TOS_GATEWAY_NAME="AnyCompany-ToS-Tool"
export MULTI_BACKEND_GATEWAY_NAME="AnyCompany-Sales-Product-Reviews-Tool"
export INVENTORY_GATEWAY_NAME="AnyCompany-Inventory-Tool"
export INVENTORY_GATEWAY_ROLE_NAME="AmazonBedrockAgentCoreGateway-InventoryToolRole"
export VENDOR_GATEWAY_NAME="AnyCompany-Vendor-Inventory-Server"

# ---------- Verified Permissions ----------
export AVP_NAMESPACE="RetailAgent"

# ---------- ECR ----------
export ECR_REPO_NAME="${PROJECT_NAME}-agent"

# ---------- Agent Proxy ----------
export AGENT_PROXY_LAMBDA_NAME="${PROJECT_NAME}-agent-proxy"
export AGENT_PROXY_API_NAME="${PROJECT_NAME}-agent-proxy"

# ---------- Bedrock Model ----------
export BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-6"
